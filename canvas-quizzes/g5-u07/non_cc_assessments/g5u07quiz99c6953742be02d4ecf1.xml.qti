<?xml version="1.0" encoding="UTF-8"?>
<questestinterop xmlns="http://www.imsglobal.org/xsd/ims_qtiasiv1p2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.imsglobal.org/xsd/ims_qtiasiv1p2 http://www.imsglobal.org/xsd/ims_qtiasiv1p2p1.xsd">
<assessment ident="g5u07quiz99c6953742be02d4ecf1" title="Unit 7 Check: Colonial America"><qtimetadata><qtimetadatafield><fieldlabel>cc_maxattempts</fieldlabel><fieldentry>1</fieldentry></qtimetadatafield></qtimetadata><section ident="root_section">
<item ident="g5u07quiz99c6953742be02d4ecf1_q1" title="Question 1"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g5u07quiz99c6953742be02d4ecf1_q1_a1,g5u07quiz99c6953742be02d4ecf1_q1_a2,g5u07quiz99c6953742be02d4ecf1_q1_a3,g5u07quiz99c6953742be02d4ecf1_q1_a4</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;Most colonists came for money, faith or a fresh start. Which people were brought to the colonies by force?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g5u07quiz99c6953742be02d4ecf1_q1_a1"><material><mattext texttype="text/plain">Indentured servants</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q1_a2"><material><mattext texttype="text/plain">Quakers</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q1_a3"><material><mattext texttype="text/plain">Enslaved Africans</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q1_a4"><material><mattext texttype="text/plain">Puritans</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g5u07quiz99c6953742be02d4ecf1_q1_a3</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar><displayfeedback feedbacktype="Response" linkrefid="correct_fb"/></respcondition><respcondition continue="Yes"><conditionvar><other/></conditionvar><displayfeedback feedbacktype="Response" linkrefid="general_incorrect_fb"/></respcondition></resprocessing><itemfeedback ident="correct_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Right. Enslaved Africans did not choose to come; they were captured and forced across the ocean.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback><itemfeedback ident="general_incorrect_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Look back at 5.07.01. Indentured servants agreed to work for years to pay for the trip; enslaved Africans had no choice.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback></item>
<item ident="g5u07quiz99c6953742be02d4ecf1_q2" title="Question 2"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g5u07quiz99c6953742be02d4ecf1_q2_a1,g5u07quiz99c6953742be02d4ecf1_q2_a2,g5u07quiz99c6953742be02d4ecf1_q2_a3,g5u07quiz99c6953742be02d4ecf1_q2_a4</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;What did William Penn’s 1701 charter for Pennsylvania allow?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g5u07quiz99c6953742be02d4ecf1_q2_a1"><material><mattext texttype="text/plain">People who believed in God could worship freely</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q2_a2"><material><mattext texttype="text/plain">Only Quakers could live in Pennsylvania</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q2_a3"><material><mattext texttype="text/plain">Anyone could hold a government job</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q2_a4"><material><mattext texttype="text/plain">Slavery was against the law</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g5u07quiz99c6953742be02d4ecf1_q2_a1</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar><displayfeedback feedbacktype="Response" linkrefid="correct_fb"/></respcondition><respcondition continue="Yes"><conditionvar><other/></conditionvar><displayfeedback feedbacktype="Response" linkrefid="general_incorrect_fb"/></respcondition></resprocessing><itemfeedback ident="correct_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Right. Pennsylvania allowed people who believed in God to worship freely, though only Christians could hold government jobs.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback><itemfeedback ident="general_incorrect_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Look back at 5.07.03. Penn’s charter allowed freedom of worship for believers in God; slavery was still legal there.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback></item>
<item ident="g5u07quiz99c6953742be02d4ecf1_q3" title="Question 3"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g5u07quiz99c6953742be02d4ecf1_q3_a1,g5u07quiz99c6953742be02d4ecf1_q3_a2,g5u07quiz99c6953742be02d4ecf1_q3_a3,g5u07quiz99c6953742be02d4ecf1_q3_a4</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;Why did many New Englanders fish, build ships and trade instead of running big farms?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g5u07quiz99c6953742be02d4ecf1_q3_a1"><material><mattext texttype="text/plain">The king ordered them to</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q3_a2"><material><mattext texttype="text/plain">New England had no forests or harbors</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q3_a3"><material><mattext texttype="text/plain">The weather was warm all year</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q3_a4"><material><mattext texttype="text/plain">Rocky soil and short summers made big farms hard</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g5u07quiz99c6953742be02d4ecf1_q3_a4</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar><displayfeedback feedbacktype="Response" linkrefid="correct_fb"/></respcondition><respcondition continue="Yes"><conditionvar><other/></conditionvar><displayfeedback feedbacktype="Response" linkrefid="general_incorrect_fb"/></respcondition></resprocessing><itemfeedback ident="correct_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Right. Geography shaped New England: rocky soil and short summers pushed people toward the sea.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback><itemfeedback ident="general_incorrect_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Look back at 5.07.02. New England had rocky soil, short summers, forests and good harbors.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback></item>
<item ident="g5u07quiz99c6953742be02d4ecf1_q4" title="Question 4"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>matching_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g5u07quiz99c6953742be02d4ecf1_q4_l1,g5u07quiz99c6953742be02d4ecf1_q4_l2,g5u07quiz99c6953742be02d4ecf1_q4_l3</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;Match each region to the way most people there earned a living.&lt;/p&gt;</mattext></material><response_lid ident="response_g5u07quiz99c6953742be02d4ecf1_q4_l1"><material><mattext texttype="text/plain">New England</mattext></material><render_choice><response_label ident="g5u07quiz99c6953742be02d4ecf1_q4_r1"><material><mattext>Fishing, shipbuilding and trade by sea</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q4_r2"><material><mattext>Wheat farms and flour mills</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q4_r3"><material><mattext>Tobacco, rice and indigo plantations</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q4_r4"><material><mattext>Gold and silver mines</mattext></material></response_label></render_choice></response_lid><response_lid ident="response_g5u07quiz99c6953742be02d4ecf1_q4_l2"><material><mattext texttype="text/plain">Middle Colonies</mattext></material><render_choice><response_label ident="g5u07quiz99c6953742be02d4ecf1_q4_r1"><material><mattext>Fishing, shipbuilding and trade by sea</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q4_r2"><material><mattext>Wheat farms and flour mills</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q4_r3"><material><mattext>Tobacco, rice and indigo plantations</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q4_r4"><material><mattext>Gold and silver mines</mattext></material></response_label></render_choice></response_lid><response_lid ident="response_g5u07quiz99c6953742be02d4ecf1_q4_l3"><material><mattext texttype="text/plain">Southern Colonies</mattext></material><render_choice><response_label ident="g5u07quiz99c6953742be02d4ecf1_q4_r1"><material><mattext>Fishing, shipbuilding and trade by sea</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q4_r2"><material><mattext>Wheat farms and flour mills</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q4_r3"><material><mattext>Tobacco, rice and indigo plantations</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q4_r4"><material><mattext>Gold and silver mines</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition><conditionvar><varequal respident="response_g5u07quiz99c6953742be02d4ecf1_q4_l1">g5u07quiz99c6953742be02d4ecf1_q4_r1</varequal></conditionvar><setvar varname="SCORE" action="Add">33.33</setvar></respcondition><respcondition><conditionvar><varequal respident="response_g5u07quiz99c6953742be02d4ecf1_q4_l2">g5u07quiz99c6953742be02d4ecf1_q4_r2</varequal></conditionvar><setvar varname="SCORE" action="Add">33.33</setvar></respcondition><respcondition><conditionvar><varequal respident="response_g5u07quiz99c6953742be02d4ecf1_q4_l3">g5u07quiz99c6953742be02d4ecf1_q4_r3</varequal></conditionvar><setvar varname="SCORE" action="Add">33.33</setvar></respcondition><respcondition continue="Yes"><conditionvar><other/></conditionvar><displayfeedback feedbacktype="Response" linkrefid="general_fb"/></respcondition></resprocessing><itemfeedback ident="general_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;When you get it right: Right. Each region earned its living from its own land and water. If you missed one: Look back at the chart in 5.07.08, or at 5.07.02, 5.07.03 and 5.07.04.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback></item>
<item ident="g5u07quiz99c6953742be02d4ecf1_q5" title="Question 5"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g5u07quiz99c6953742be02d4ecf1_q5_a1,g5u07quiz99c6953742be02d4ecf1_q5_a2,g5u07quiz99c6953742be02d4ecf1_q5_a3,g5u07quiz99c6953742be02d4ecf1_q5_a4</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;Most free families in the Southern Colonies were…&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g5u07quiz99c6953742be02d4ecf1_q5_a1"><material><mattext texttype="text/plain">rich planters with large plantations</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q5_a2"><material><mattext texttype="text/plain">merchants who lived in London</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q5_a3"><material><mattext texttype="text/plain">small farmers</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q5_a4"><material><mattext texttype="text/plain">overseers on rice plantations</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g5u07quiz99c6953742be02d4ecf1_q5_a3</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar><displayfeedback feedbacktype="Response" linkrefid="correct_fb"/></respcondition><respcondition continue="Yes"><conditionvar><other/></conditionvar><displayfeedback feedbacktype="Response" linkrefid="general_incorrect_fb"/></respcondition></resprocessing><itemfeedback ident="correct_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Right. Rich planters had the most power, but most free Southern families were small farmers.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback><itemfeedback ident="general_incorrect_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Look back at 5.07.04. Planters were a small, powerful group; most free families had small farms.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback></item>
<item ident="g5u07quiz99c6953742be02d4ecf1_q6" title="Question 6"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_answers_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g5u07quiz99c6953742be02d4ecf1_q6_a1,g5u07quiz99c6953742be02d4ecf1_q6_a2,g5u07quiz99c6953742be02d4ecf1_q6_a3,g5u07quiz99c6953742be02d4ecf1_q6_a4</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;What shaped what a colonist’s day looked like? Choose ALL that are right.&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Multiple"><render_choice><response_label ident="g5u07quiz99c6953742be02d4ecf1_q6_a1"><material><mattext texttype="text/plain">Where they lived</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q6_a2"><material><mattext texttype="text/plain">How much money they had</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q6_a3"><material><mattext texttype="text/plain">Whether they were free or enslaved</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q6_a4"><material><mattext texttype="text/plain">Nothing: daily life was the same in every colony</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><and><varequal respident="response1">g5u07quiz99c6953742be02d4ecf1_q6_a1</varequal><varequal respident="response1">g5u07quiz99c6953742be02d4ecf1_q6_a2</varequal><varequal respident="response1">g5u07quiz99c6953742be02d4ecf1_q6_a3</varequal><not><varequal respident="response1">g5u07quiz99c6953742be02d4ecf1_q6_a4</varequal></not></and></conditionvar><setvar action="Set" varname="SCORE">100</setvar><displayfeedback feedbacktype="Response" linkrefid="correct_fb"/></respcondition><respcondition continue="Yes"><conditionvar><other/></conditionvar><displayfeedback feedbacktype="Response" linkrefid="general_incorrect_fb"/></respcondition></resprocessing><itemfeedback ident="correct_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Right. Region, wealth, race and whether a person was free or enslaved all shaped daily life.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback><itemfeedback ident="general_incorrect_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Look back at 5.07.05. Daily life was very different from person to person and place to place.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback></item>
<item ident="g5u07quiz99c6953742be02d4ecf1_q7" title="Question 7"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g5u07quiz99c6953742be02d4ecf1_q7_a1,g5u07quiz99c6953742be02d4ecf1_q7_a2,g5u07quiz99c6953742be02d4ecf1_q7_a3,g5u07quiz99c6953742be02d4ecf1_q7_a4</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;In the triangular trade, which leg carried enslaved Africans across the Atlantic?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g5u07quiz99c6953742be02d4ecf1_q7_a1"><material><mattext texttype="text/plain">Africa to the Americas, called the Middle Passage</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q7_a2"><material><mattext texttype="text/plain">Europe to Africa, carrying cloth and guns</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q7_a3"><material><mattext texttype="text/plain">The Americas to Europe, carrying sugar and tobacco</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q7_a4"><material><mattext texttype="text/plain">Boston to Philadelphia, carrying fish</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g5u07quiz99c6953742be02d4ecf1_q7_a1</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar><displayfeedback feedbacktype="Response" linkrefid="correct_fb"/></respcondition><respcondition continue="Yes"><conditionvar><other/></conditionvar><displayfeedback feedbacktype="Response" linkrefid="general_incorrect_fb"/></respcondition></resprocessing><itemfeedback ident="correct_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Right. The Middle Passage carried millions of captive Africans to the Americas, and many died on the way.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback><itemfeedback ident="general_incorrect_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Look back at 5.07.06. Leg 2, the Middle Passage, went from Africa to the Americas.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback></item>
<item ident="g5u07quiz99c6953742be02d4ecf1_q8" title="Question 8"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g5u07quiz99c6953742be02d4ecf1_q8_a1,g5u07quiz99c6953742be02d4ecf1_q8_a2,g5u07quiz99c6953742be02d4ecf1_q8_a3,g5u07quiz99c6953742be02d4ecf1_q8_a4</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;What was Fort Mose, built in 1738?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g5u07quiz99c6953742be02d4ecf1_q8_a1"><material><mattext texttype="text/plain">A British fort that guarded Georgia</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q8_a2"><material><mattext texttype="text/plain">A rice plantation in South Carolina</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q8_a3"><material><mattext texttype="text/plain">A town in Virginia where the 1662 law was written</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q8_a4"><material><mattext texttype="text/plain">A free Black town in Spanish Florida, built by people who escaped slavery</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g5u07quiz99c6953742be02d4ecf1_q8_a4</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar><displayfeedback feedbacktype="Response" linkrefid="correct_fb"/></respcondition><respcondition continue="Yes"><conditionvar><other/></conditionvar><displayfeedback feedbacktype="Response" linkrefid="general_incorrect_fb"/></respcondition></resprocessing><itemfeedback ident="correct_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Right. Fort Mose, near St. Augustine, was the first legally free Black town in what is now the United States.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback><itemfeedback ident="general_incorrect_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Look back at 5.07.07, card 5: people who escaped slavery in Carolina built Fort Mose in Spanish Florida.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback></item>
<item ident="g5u07quiz99c6953742be02d4ecf1_q9" title="Question 9"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g5u07quiz99c6953742be02d4ecf1_q9_a1,g5u07quiz99c6953742be02d4ecf1_q9_a2,g5u07quiz99c6953742be02d4ecf1_q9_a3,g5u07quiz99c6953742be02d4ecf1_q9_a4</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;John Mitchell’s 1755 map shows harbors, rivers and colony borders. Which question would you need a different source to answer?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g5u07quiz99c6953742be02d4ecf1_q9_a1"><material><mattext texttype="text/plain">Where was Chesapeake Bay?</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q9_a2"><material><mattext texttype="text/plain">Which colonies were on the coast?</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q9_a3"><material><mattext texttype="text/plain">Who did most of the work on Southern plantations?</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q9_a4"><material><mattext texttype="text/plain">Where was Boston’s harbor?</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g5u07quiz99c6953742be02d4ecf1_q9_a3</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar><displayfeedback feedbacktype="Response" linkrefid="correct_fb"/></respcondition><respcondition continue="Yes"><conditionvar><other/></conditionvar><displayfeedback feedbacktype="Response" linkrefid="general_incorrect_fb"/></respcondition></resprocessing><itemfeedback ident="correct_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Right. A map shows where places were. It can’t show who did the work or how people lived.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback><itemfeedback ident="general_incorrect_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Look back at the map check in 5.07.08. The map shows places, but no people or work.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback></item>
<item ident="g5u07quiz99c6953742be02d4ecf1_q10" title="Question 10"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g5u07quiz99c6953742be02d4ecf1_q10_a1,g5u07quiz99c6953742be02d4ecf1_q10_a2,g5u07quiz99c6953742be02d4ecf1_q10_a3,g5u07quiz99c6953742be02d4ecf1_q10_a4</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;An editor writes: “One region cannot stand for all thirteen colonies.” Which detail BEST supports that claim?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g5u07quiz99c6953742be02d4ecf1_q10_a1"><material><mattext texttype="text/plain">New England fished and traded, while the South grew tobacco and rice on plantations</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q10_a2"><material><mattext texttype="text/plain">By 1750, slavery was legal in all thirteen colonies</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q10_a3"><material><mattext texttype="text/plain">The Old Ship Meetinghouse was built in 1681</mattext></material></response_label><response_label ident="g5u07quiz99c6953742be02d4ecf1_q10_a4"><material><mattext texttype="text/plain">Ships carried flour from New York to Boston</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g5u07quiz99c6953742be02d4ecf1_q10_a1</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar><displayfeedback feedbacktype="Response" linkrefid="correct_fb"/></respcondition><respcondition continue="Yes"><conditionvar><other/></conditionvar><displayfeedback feedbacktype="Response" linkrefid="general_incorrect_fb"/></respcondition></resprocessing><itemfeedback ident="correct_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;Right. This detail shows two regions earning a living in very different ways.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback><itemfeedback ident="general_incorrect_fb"><flow_mat><material><mattext texttype="text/html">&lt;p&gt;That detail is true, but it shows something the regions shared or a single place. Look back at rows 1–4 of the chart in 5.07.08.&lt;/p&gt;</mattext></material></flow_mat></itemfeedback></item>
</section></assessment></questestinterop>
